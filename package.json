{
  "name": "slayer-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-data.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
